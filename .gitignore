# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pkl

# Packaging and distribution
dist/
build/
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Generated outputs. Every run owns a folder: results/<dataset>/{figures,tables}/
# Ignore the heavy artifacts (figures, saved models) but keep the reports, the
# per-run metrics JSON and the cross-run index — those are the reviewable record.
results/*/figures/
results/*/best_model.pkl
!results/*/tables/
!results/*/report_*.pdf
!results/INDEX.md

# Legacy flat layout from before per-dataset folders
results/figures/
results/tables/
results/best_model.pkl

# Downloaded datasets / OpenML cache
data/*
!data/.gitkeep

# OS / editor
.DS_Store
.ipynb_checkpoints/
.vscode/
.idea/
